suffix_id : DIGITS | BARE_ID ; 
ssa_id : TERM_1 suffix_id ( TERM_2 DIGITS )? ; 
symbol_ref_id : TERM_3 ( suffix_id | string_literal ) ; 
block_id : TERM_4 suffix_id ; 
type_alias : TERM_5 ( string_literal | BARE_ID | ( BARE_ID | TERM_6 )+ ) ; 
map_or_set_id : TERM_2 suffix_id ; 
attribute_alias : TERM_2 ( string_literal | BARE_ID ) ; 
ssa_id_list : ssa_id ( TERM_7 ssa_id )* ; 
ssa_use : ssa_id | constant_literal ; 
ssa_use_list : ssa_use ( TERM_7 ssa_use )* ; 
opaque_dialect_item : BARE_ID TERM_8 string_literal TERM_9 ; 
pretty_dialect_item : ( BARE_ID TERM_6 )? BARE_ID pretty_dialect_item_body? ; 
pretty_dialect_item_body : TERM_8 pretty_dialect_item_contents ( TERM_7 pretty_dialect_item_contents )* TERM_9 ; 
pretty_dialect_item_contents : ( TERM_10 pretty_dialect_item_contents TERM_11 ) | ( TERM_12 pretty_dialect_item_contents? ( TERM_7 pretty_dialect_item_contents )* TERM_13 ) | ( TERM_14 pretty_dialect_item_contents TERM_15 ) | pretty_dialect_item_other_content+ ; 
pretty_dialect_item_other_content : BARE_ID | constant_literal | type | TERM_16 | TERM_17 | TERM_7 | TERM_18 ; 
dialect_type : TERM_5? ( opaque_dialect_item | pretty_dialect_item ) ; 
non_function_type : type_alias | dialect_type | BARE_ID | constant_literal ; 
type : non_function_type | function_type ; 
type_list_no_parens : type ( TERM_7 type )* ; 
type_list_parens : ( TERM_10 TERM_11 ) | ( TERM_10 type_list_no_parens TERM_11 ) ; 
ssa_use_and_type : ssa_use TERM_18 type ; 
ssa_use_and_type_list : ssa_use_and_type ( TERM_7 ssa_use_and_type )* ; 
array_attribute : TERM_12 ( attribute_value ( TERM_7 attribute_value )* )? TERM_13 ; 
bool_attribute : bool_literal ; 
dictionary_attribute : TERM_14 ( attribute_entry ( TERM_7 attribute_entry )* )? TERM_15 ; 
float_attribute : ( FLOAT_LITERAL optional_type ) | ( HEXADECIMAL_LITERAL TERM_18 type ) ; 
integer_attribute : posneg_integer_literal optional_type ; 
string_attribute : string_literal optional_type ; 
symbol_ref_attribute : ( symbol_ref_id ( TERM_19 symbol_ref_id )* ) ; 
type_attribute : type ; 
standard_attribute : array_attribute | bool_attribute | dictionary_attribute | float_attribute | integer_attribute | string_attribute | symbol_ref_attribute | type_attribute ; 
attribute_value : attribute_alias | dialect_attribute | standard_attribute ; 
dependent_attribute_entry : BARE_ID TERM_20 attribute_value ; 
dialect_attribute_entry : ( BARE_ID TERM_6 BARE_ID ) | ( BARE_ID TERM_6 BARE_ID TERM_20 attribute_value ) | ( string_literal TERM_20 attribute_value ) ; 
dialect_attribute : TERM_2? ( opaque_dialect_item | pretty_dialect_item ) ( TERM_18 type )? ; 
property_dict : TERM_8 attribute_dict TERM_9 ; 
attribute_entry : dialect_attribute_entry | dependent_attribute_entry | BARE_ID ; 
attribute_dict : ( TERM_14 TERM_15 ) | ( TERM_14 attribute_entry ( TERM_7 attribute_entry )* TERM_15 ) ; 
trailing_type : TERM_18 function_type ; 
function_type : function_type_list ( TERM_21 | TERM_22 | TERM_23 ) function_type_list ; 
function_type_list : TERM_10 non_function_type? ( TERM_7 non_function_type )* TERM_11 | non_function_type? ( TERM_7 non_function_type )* ; 
op_result : ssa_id optional_int_literal ; 
op_result_list : op_result ( TERM_7 op_result )* TERM_20 ; 
location : string_literal TERM_18 decimal_literal TERM_18 decimal_literal ; 
trailing_location : ( TERM_24 TERM_10 location TERM_11 ) ; 
generic_operation : string_literal TERM_10 optional_ssa_use_list TERM_11 optional_successor_list optional_prop_dict optional_region_list optional_attr_dict trailing_type ; 
custom_operation : BARE_ID TERM_6 BARE_ID optional_ssa_use_list trailing_type ; 
operation : optional_op_result_list ( custom_operation | generic_operation | generic_module ) optional_trailing_loc ; 
ssa_id_and_type : ssa_id TERM_18 type ; 
ssa_id_and_type_list : ssa_id_and_type ( TERM_7 ssa_id_and_type )* ; 
block_arg_list : TERM_10 optional_ssa_and_type_list TERM_11 ; 
operation_list : operation+ ; 
block_label : block_id optional_block_arg_list TERM_18 ; 
successor_list : TERM_12 block_id? ( TERM_7 block_id )* TERM_13 ; 
block : optional_block_label operation_list ; 
region : TERM_14 block* TERM_15 ; 
region_list : TERM_10 region? ( TERM_7 region )* TERM_11 ; 
optional_symbol_ref_id : symbol_ref_id? ; 
optional_func_mod_attrs : ( TERM_25 attribute_dict )? ; 
optional_arg_list : argument_list? ; 
optional_fn_result_list : ( TERM_21 function_result_list )? ; 
optional_fn_body : function_body? ; 
optional_symbol_id_list : symbol_id_list? ; 
optional_type : ( TERM_18 type )? ; 
optional_int_literal : ( TERM_18 integer_literal )? ; 
optional_ssa_use_list : ssa_use_list? ; 
optional_prop_dict : property_dict? ; 
optional_attr_dict : attribute_dict? ; 
optional_trailing_loc : trailing_location? ; 
optional_op_result_list : op_result_list? ; 
optional_ssa_and_type_list : ssa_id_and_type_list? ; 
optional_block_arg_list : block_arg_list? ; 
optional_block_label : block_label? ; 
optional_symbol_use_list : symbol_use_list? ; 
optional_successor_list : successor_list? ; 
optional_region_list : region_list? ; 
named_argument : ssa_id TERM_18 type optional_attr_dict ; 
argument_list : ( named_argument ( TERM_7 named_argument )* ) | ( type optional_attr_dict ( TERM_7 type optional_attr_dict )* ) ; 
function_result : type optional_attr_dict ; 
function_result_list_no_parens : function_result ( TERM_7 function_result )* ; 
function_result_list_parens : ( TERM_10 TERM_11 ) | ( TERM_10 function_result_list_no_parens TERM_11 ) ; 
function_result_list : function_result_list_parens ; 
function_body : region ; 
generic_module : string_literal TERM_10 argument_list? TERM_11 TERM_10 region TERM_11 attribute_dict? trailing_type trailing_location? ; 
dim_id_list : TERM_10 BARE_ID? ( TERM_7 BARE_ID )* TERM_11 ; 
symbol_id_list : TERM_12 BARE_ID? ( TERM_7 BARE_ID )* TERM_13 ; 
dim_and_symbol_id_lists : dim_id_list optional_symbol_id_list ; 
symbol_or_const : posneg_integer_literal | ssa_id | BARE_ID ; 
dim_use_list : TERM_10 ssa_use_list? TERM_11 ; 
symbol_use_list : TERM_12 ssa_use_list? TERM_13 ; 
dim_and_symbol_use_list : dim_use_list optional_symbol_use_list ; 
type_alias_def : type_alias TERM_20 TERM_26 type ; 
attribute_alias_def : attribute_alias TERM_20 attribute_value ; 
definition : type_alias_def | attribute_alias_def ; 
definition_list : definition+ ; 
module_list : generic_module+ ; 
definition_and_module_list : definition_list | module_list | definition_list module_list ; 
mlir_file : definition_and_module_list+ ; 
start_rule : mlir_file ; 