parser grammar bParser;
options { tokenVocab=bLexer; }

program : definition* EOF ; 
definition : name constant? ( ival ( TERM_0 ival )* )* TERM_1 | name TERM_2 ( name ( TERM_0 name )* )? TERM_3 statement ; 
ival : constant | name ; 
statement : externsmt | autosmt | name TERM_4 statement | casestmt | blockstmt | ifstmt | whilestmt | switchstmt | gotostmt | returnstmt | expressionstmt | nullstmt ; 
nullstmt : TERM_1 ; 
expressionstmt : rvalue TERM_1 ; 
blockstmt : TERM_5 statement* TERM_6 ; 
returnstmt : TERM_7 ( TERM_2 rvalue TERM_3 )? TERM_1 ; 
gotostmt : TERM_8 rvalue TERM_1 ; 
switchstmt : TERM_9 rvalue statement ; 
whilestmt : TERM_10 TERM_2 rvalue TERM_3 statement ; 
ifstmt : TERM_11 TERM_2 rvalue TERM_3 statement ( TERM_12 statement )? ; 
casestmt : TERM_13 constant TERM_4 statement ; 
externsmt : TERM_14 name ( TERM_0 name )* TERM_1 ; 
autosmt : TERM_15 name constant? ( TERM_0 name constant? )* TERM_1 ; 
rvalue : expression | comparison | ternary | assignment ; 
ternary : expression TERM_16 rvalue TERM_4 rvalue ; 
comparison : expression binary rvalue ; 
assignment : name assign rvalue ; 
expression : TERM_2 rvalue TERM_3 | name | constant | incdec name | name incdec | unary rvalue | TERM_17 name | functioninvocation ; 
functioninvocation : name TERM_2 functionparameters? TERM_3 ; 
functionparameters : rvalue ( TERM_0 rvalue )* ; 
assign : TERM_18 binary? ; 
incdec : TERM_19 | TERM_20 ; 
unary : TERM_21 | TERM_22 ; 
binary : TERM_23 | TERM_17 | TERM_24 | TERM_25 | TERM_26 | TERM_27 | TERM_28 | TERM_29 | TERM_30 | TERM_31 | TERM_21 | TERM_32 | TERM_33 | TERM_34 | TERM_35 ; 
lvalue : name | TERM_34 rvalue | rvalue TERM_36 rvalue TERM_37 ; 
constant : INT | STRING1 | STRING2 ; 
name : NAME ; 