lexer grammar bLexer;

TERM_0 : ',' ;
TERM_1 : ';' ;
TERM_2 : '(' ;
TERM_3 : ')' ;
TERM_4 : ':' ;
TERM_5 : '{' ;
TERM_6 : '}' ;
TERM_7 : 'return' ;
TERM_8 : 'goto' ;
TERM_9 : 'switch' ;
TERM_10 : 'while' ;
TERM_11 : 'if' ;
TERM_12 : 'else' ;
TERM_13 : 'case' ;
TERM_14 : 'extrn' ;
TERM_15 : 'auto' ;
TERM_16 : '?' ;
TERM_17 : '&' ;
TERM_18 : '=' ;
TERM_19 : '++' ;
TERM_20 : '--' ;
TERM_21 : '-' ;
TERM_22 : '!' ;
TERM_23 : '|' ;
TERM_24 : '==' ;
TERM_25 : '!=' ;
TERM_26 : '<' ;
TERM_27 : '<=' ;
TERM_28 : '>' ;
TERM_29 : '>=' ;
TERM_30 : '<<' ;
TERM_31 : '>>' ;
TERM_32 : '+' ;
TERM_33 : '%' ;
TERM_34 : '*' ;
TERM_35 : '/' ;
TERM_36 : '[' ;
TERM_37 : ']' ;

NAME : [a-zA-Z] [a-zA-Z0-9_]* ;
INT : [0-9]+ ;
STRING1 : '"' ~ ["\r\n]* '"' ;
STRING2 : '\'' ~ ['\r\n]* '\'' ;
BLOCKCOMMENT : '/*' . *? '*/' -> skip ;
WS : [ \t\r\n] -> skip ;