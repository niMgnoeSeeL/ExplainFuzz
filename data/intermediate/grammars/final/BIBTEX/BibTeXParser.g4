parser grammar BibTeXParser;

options { tokenVocab=BibTeXLexer;}

bibTex : entry_star EOF 
| EOF ;

entry_star : entry entry_star 
| ARTICLE LBRACE IDENTIFIER COMMA field_plus RBRACE 
| BOOK LBRACE IDENTIFIER COMMA field_plus RBRACE 
| BOOKLET LBRACE IDENTIFIER COMMA field_plus RBRACE 
| INBOOK LBRACE IDENTIFIER COMMA field_plus RBRACE 
| INCOLLECTION LBRACE IDENTIFIER COMMA field_plus RBRACE 
| INPROCEEDINGS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| PROCEEDINGS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| MANUAL LBRACE IDENTIFIER COMMA field_plus RBRACE 
| MASTERTHESIS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| PHDTHESIS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| MISC LBRACE IDENTIFIER COMMA field_plus RBRACE 
| TECHREPORT LBRACE IDENTIFIER COMMA field_plus RBRACE 
| UNPUBLISHED LBRACE IDENTIFIER COMMA field_plus RBRACE ;

field : key EQ value COMMA ;

key : IDENTIFIER ;

value : INTEGER_LITERAL 
| STRING_LITERAL ;

article : ARTICLE LBRACE IDENTIFIER COMMA field_plus RBRACE ;

field_plus : field field_plus 
| key EQ value COMMA ;

book : BOOK LBRACE IDENTIFIER COMMA field_plus RBRACE ;

booklet : BOOKLET LBRACE IDENTIFIER COMMA field_plus RBRACE ;

inbook : INBOOK LBRACE IDENTIFIER COMMA field_plus RBRACE ;

incollection : INCOLLECTION LBRACE IDENTIFIER COMMA field_plus RBRACE ;

inproceedings : INPROCEEDINGS LBRACE IDENTIFIER COMMA field_plus RBRACE ;

proceedings : PROCEEDINGS LBRACE IDENTIFIER COMMA field_plus RBRACE ;

manual : MANUAL LBRACE IDENTIFIER COMMA field_plus RBRACE ;

mastersthesis : MASTERTHESIS LBRACE IDENTIFIER COMMA field_plus RBRACE ;

phdthesis : PHDTHESIS LBRACE IDENTIFIER COMMA field_plus RBRACE ;

misc : MISC LBRACE IDENTIFIER COMMA field_plus RBRACE ;

techreport : TECHREPORT LBRACE IDENTIFIER COMMA field_plus RBRACE ;

unpublished : UNPUBLISHED LBRACE IDENTIFIER COMMA field_plus RBRACE ;

entry : ARTICLE LBRACE IDENTIFIER COMMA field_plus RBRACE 
| BOOK LBRACE IDENTIFIER COMMA field_plus RBRACE 
| BOOKLET LBRACE IDENTIFIER COMMA field_plus RBRACE 
| INBOOK LBRACE IDENTIFIER COMMA field_plus RBRACE 
| INCOLLECTION LBRACE IDENTIFIER COMMA field_plus RBRACE 
| INPROCEEDINGS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| PROCEEDINGS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| MANUAL LBRACE IDENTIFIER COMMA field_plus RBRACE 
| MASTERTHESIS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| PHDTHESIS LBRACE IDENTIFIER COMMA field_plus RBRACE 
| MISC LBRACE IDENTIFIER COMMA field_plus RBRACE 
| TECHREPORT LBRACE IDENTIFIER COMMA field_plus RBRACE 
| UNPUBLISHED LBRACE IDENTIFIER COMMA field_plus RBRACE ;

