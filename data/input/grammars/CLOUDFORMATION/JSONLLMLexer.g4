lexer grammar JSONLLMLexer;

// Punctuation and keywords
LBRACE  : '{';
RBRACE  : '}';
LBRACK  : '[';
RBRACK  : ']';
COLON   : ':';
COMMA   : ',';

TRUE    : 'true';
FALSE   : 'false';
NULL    : 'null';
QUOTE   :  '"' ;

// Numbers

NUMBER:
    '-'? INT ('.' [0-9]+)? EXP?
;

fragment INT:
    '0'
    | [1-9] [0-9]*
;

fragment EXP:
    [Ee] [+\-]? [0-9]+
;

WS:
    [ \t\n\r]+ -> skip
;



